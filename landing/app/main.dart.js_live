B.Y8={"\ud83d\udd27 \u03a5\u03b4\u03c1\u03b1\u03c5\u03bb\u03b9\u03ba\u03ac":0,"\u26a1 \u0397\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bb\u03cc\u03b3\u03bf\u03b9":1,"\u2744\ufe0f HVAC / \u039a\u03bb\u03b9\u03bc\u03b1\u03c4\u03b9\u03c3\u03bc\u03cc\u03c2":2,"\ud83e\ude9f \u039a\u03bf\u03c5\u03c6\u03ce\u03bc\u03b1\u03c4\u03b1 & \u03a4\u03b6\u03ac\u03bc\u03b9\u03b1":3,"\ud83c\udfe0 \u039c\u03bf\u03bd\u03ce\u03c3\u03b5\u03b9\u03c2 & \u03a4\u03ad\u03bd\u03c4\u03b5\u03c2":4,"\u2692\ufe0f \u03a3\u03b9\u03b4\u03b7\u03c1\u03bf\u03c5\u03c1\u03b3\u03b9\u03ba\u03ac & \u039c\u03b1\u03c1\u03bc\u03b1\u03c1\u03b9\u03ba\u03ac":5,"\ud83c\udfd7\ufe0f \u0391\u03bd\u03b1\u03ba\u03b1\u03b9\u03bd\u03af\u03c3\u03b5\u03b9\u03c2 & \u039a\u03b1\u03c4\u03b1\u03c3\u03ba\u03b5\u03c5\u03ad\u03c2":6,"\ud83c\udfa8 \u0392\u03b1\u03c6\u03ae & \u0394\u03b9\u03b1\u03ba\u03cc\u03c3\u03bc\u03b7\u03c3\u03b7":7,"\ud83d\udd12 \u039a\u03bb\u03b5\u03b9\u03b4\u03b1\u03c1\u03b9\u03ad\u03c2 & \u0391\u03c3\u03c6\u03ac\u03bb\u03b5\u03b9\u03b1":8,"\ud83d\udd28 \u039e\u03c5\u03bb\u03bf\u03c5\u03c1\u03b3\u03b9\u03ba\u03ac & \u0395\u03c0\u03af\u03c0\u03bb\u03c9\u03c3\u03b7":9,"\ud83d\uded7 \u0391\u03bd\u03b5\u03bb\u03ba\u03c5\u03c3\u03c4\u03ae\u03c1\u03b5\u03c2":10,"\ud83c\udf3f \u039a\u03ae\u03c0\u03bf\u03c2 & \u0395\u03be\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03bf\u03af \u03c7\u03ce\u03c1\u03bf\u03b9":11,"\ud83e\uddf9 \u039a\u03b1\u03b8\u03b1\u03c1\u03b9\u03c3\u03bc\u03cc\u03c2":12,"\ud83d\udce6 \u039c\u03b5\u03c4\u03b1\u03c6\u03bf\u03c1\u03ad\u03c2 & \u039c\u03b5\u03c4\u03b1\u03ba\u03bf\u03bc\u03af\u03c3\u03b5\u03b9\u03c2":13,"\ud83d\ude97 \u0391\u03c5\u03c4\u03bf\u03ba\u03af\u03bd\u03b7\u03c4\u03bf":14,"\ud83c\udfe5 \u03a0\u03b1\u03b8\u03bf\u03bb\u03cc\u03b3\u03bf\u03c2 / \u0393\u03b5\u03bd\u03b9\u03ba\u03ae \u0399\u03b1\u03c4\u03c1\u03b9\u03ba\u03ae":15,"\ud83d\udc76 \u03a0\u03b1\u03b9\u03b4\u03af\u03b1\u03c4\u03c1\u03bf\u03c2":16,"\ud83e\uddb7 \u039f\u03b4\u03bf\u03bd\u03c4\u03af\u03b1\u03c4\u03c1\u03bf\u03c2":17,"\u