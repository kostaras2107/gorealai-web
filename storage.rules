rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Ταυτότητες / ποινικά μητρώα για την επαλήθευση ασφαλείας: ανεβάζει μόνο
    // ο ίδιος ο επαγγελματίας (μόνο εικόνες, έως 15MB), βλέπει μόνο ο admin.
    match /verification/{uid}/{file} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && (request.auth.token.admin == true || request.auth.uid == uid);
    }
    // Όλα τα υπόλοιπα (profile_photos, requests, offers, chat_media, portfolio…)
    match /{folder}/{allPaths=**} {
      allow read: if folder != 'verification';
      allow write: if request.auth != null && folder != 'verification';
    }
  }
}
